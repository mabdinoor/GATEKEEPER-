# ─── Gmail SMTP ───────────────────────────────────────────────────────────────
# Your Gmail address
GMAIL_USER=mabdinoor17@gmail.com

# Gmail App Password (NOT your normal Gmail password)
# How to get one:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification if not already on
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Create a new app password → select "Mail" → copy the 16-char code
GMAIL_PASS=yrju vssp txtw iqcz

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
# Full connection string. Example for a local Postgres instance:
#   postgres://gatekeeper:password@localhost:5432/gatekeeper
# Example for a hosted provider that requires SSL, add PGSSL=true below.
DATABASE_URL=postgres://gatekeeper:Abahurayra101@localhost:5432/gatekeeper

# Set to "true" if your Postgres provider requires SSL (most hosted DBs do)
PGSSL=false

# ─── Billing (Stripe) ─────────────────────────────────────────────────────────
# Get test-mode keys at https://dashboard.stripe.com/test/apikeys
# Leave blank in local dev to disable billing routes entirely.
STRIPE_SECRET_KEY=

# From https://dashboard.stripe.com/test/webhooks (or the Stripe CLI's
# `stripe listen --forward-to localhost:4000/api/billing/webhook` output).
# Required in production — without it, the webhook accepts unverified
# requests, which anyone could exploit to grant themselves a paid plan.
STRIPE_WEBHOOK_SECRET=

# Price IDs from https://dashboard.stripe.com/test/prices (create a
# recurring monthly Price for each paid plan, then paste its ID here —
# looks like price_1AbCdEfGhIjKlMnO).
STRIPE_PRICE_ID_PRO=
STRIPE_PRICE_ID_ENTERPRISE=

# ─── Admin panel ──────────────────────────────────────────────────────────────
# Single hardcoded operator login for the /admin panel — not tied to any
# company or officer account. Leave blank to disable admin login entirely
# (the login route returns a clear 503 instead of a crash).
ADMIN_USERNAME=
ADMIN_PASSWORD=

# ─── App settings ─────────────────────────────────────────────────────────────
# The URL your frontend runs on (used in email links)
FRONTEND_URL=http://localhost:5173

# Secret for JWT tokens — change this to any long random string in production
JWT_SECRET=gatekeeper-secret-change-in-prod

# Backend port
PORT=4000

# ─── Logging ──────────────────────────────────────────────────────────────────
# "production" switches logs to structured JSON; anything else (or unset)
# gives colorized, human-readable console output instead.
NODE_ENV=development
# One of: error, warn, info, debug
LOG_LEVEL=info
